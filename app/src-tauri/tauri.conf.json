{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mynota",
  "version": "0.7.0-beta.2",
  "identifier": "app.mynota.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "title": "Mynota",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
          "scope": ["$RESOURCE/**/*", "$APPDATA/**/*", "$HOME/mynota/**", "$HOME/Library/Mobile Documents/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "publisher": "Mynota",
    "copyright": "Copyright © 2026 Mynota contributors. MIT licensed. Based on Myna.",
    "category": "Productivity",
    "shortDescription": "Local-first AI meeting recorder and summarizer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../templates": "templates",
      "../../scripts": "scripts"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NEFDQ0E3REYwMEU1MTkKUldRWjVRRGZwOHhLbVFlUzJRazNkeEwxN2xIeDZWeS9pOWJBcEpTSGd1OENBYStrOXpKdUtwR3AK",
      "endpoints": ["https://github.com/lolofx/mynota/releases/download/beta-manifest/latest.json"]
    }
  }
}
